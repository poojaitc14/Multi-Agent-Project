# Copy to .env for local dev. No real secrets belong in this file or in .env
# committed to source.

# Postgres (RDS locally, per project-plan.md Q9)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fraud_triage

# DynamoDB + S3 -- real AWS, both locally and once deployed (LocalStack
# was dropped, project-plan.md Q51). Real AWS credentials must be available
# via the standard boto3 chain: AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY env
# vars, ~/.aws/credentials, or an IAM role. Table/bucket names below are
# dev-prefixed so local runs never touch the deployed environment's data.
#
# AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY/AWS_SESSION_TOKEN are only needed
# when running the mcp-server via infra/docker-compose.yml (project-plan.md's
# Dockerfiles slice) -- running mcp-servers/orchestrator_server.py directly
# on this machine resolves credentials some other way (not the standard
# ~/.aws files -- mounting ~/.aws into a container was tried for real and
# confirmed NOT to work here) and doesn't need these set. Leave unset for
# non-Docker local dev. If set for Docker Compose, they're almost certainly
# temporary (an assumed-role session token) and will need refreshing
# periodically -- not committed to source, real values belong in .env only.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_DEFAULT_REGION=us-east-1
CONVERSATION_STATE_TABLE=conversation-state-dev
CLAIM_PHOTOS_BUCKET=claim-photos-dev
TRANSCRIPTS_BUCKET=chat-transcripts-dev
CLAIM_FREQUENCY_TABLE=claim-frequency-dev

# TrackingMore (free tier) -- get_tracking_status's real delivery_status
# lookup. Optional: if unset, get_tracking_status skips the network call and
# returns delivery_status: "unknown" directly, same as what a real call
# returns after retries when there's no match.
TRACKINGMORE_API_KEY=

# The single MCP server (Q55 -- one server for all 4 agents' tools now).
# MCP_SERVER_HOST defaults to 127.0.0.1 for local (non-Docker) dev; Docker
# Compose overrides it to the "mcp-server" service name (project-plan.md's
# Dockerfiles slice) so the backend container can reach it over the compose
# network instead of trying (and failing) to hit its own loopback.
MCP_SERVER_HOST=127.0.0.1
MCP_SERVER_PORT=8001

# Reviewer Dashboard access gate (Q31/Q72) -- shared password, checked by
# both the Streamlit Admin app and the review-queue backend endpoints
# directly (defense in depth, not a UI-only gate).
REVIEWER_PASSWORD=replace-with-a-real-random-password

# FastAPI backend URL for the Streamlit Admin app to call
BACKEND_URL=http://127.0.0.1:8002

# Per-agent bearer tokens (Q55) -- each agent authenticates with its own,
# only ORCHESTRATOR_MCP_TOKEN is allowed to call issue_refund. Generate real
# random values for local dev, e.g. `python -c "import secrets; print(secrets.token_hex(24))"`
# -- these placeholders are not secrets, just labels showing what's expected.
ORCHESTRATOR_MCP_TOKEN=replace-with-a-real-random-token
IMAGE_PARSING_MCP_TOKEN=replace-with-a-real-random-token
FRAUD_SCORING_MCP_TOKEN=replace-with-a-real-random-token
DECISION_MCP_TOKEN=replace-with-a-real-random-token

# Langfuse Cloud (Q73) -- sign up at langfuse.com for a free-tier project
# to get these. LANGFUSE_HOST is the exact name litellm's real Langfuse
# integration reads (confirmed against its source + official docs).
LANGFUSE_PUBLIC_KEY=replace-with-your-langfuse-public-key
LANGFUSE_SECRET_KEY=replace-with-your-langfuse-secret-key
LANGFUSE_HOST=https://cloud.langfuse.com

# Customer-facing chat frontend (project-plan.md Q78) -- a second Streamlit
# app, separate from admin/app.py, on its own port.
CHAT_PORT=8503
