.venv/
__pycache__/
*.pyc
.env
.pytest_cache/
ml/data/*.csv
!ml/data/.gitkeep
# synthetic_fraud_risk_dataset.csv has no reproducible generation script
# (ml/model_training.ipynb only reads it) -- CI and any fresh clone need
# the real file itself, not a regenerate-on-demand step that doesn't
# exist. Committed as a real project asset, same treatment
# docs/refund_policy.md already gets (.dockerignore's docs/* + negation).
!ml/data/synthetic_fraud_risk_dataset.csv
ml/*.joblib
ml/.ipynb_checkpoints/
ml/mlruns/

# Raw third-party dataset downloads (e.g. the Roboflow Damaged Package
# Detection zip, project-plan.md Q89) -- only the small, reviewed sample
# copied into tests/fixtures/images/ is meant to be tracked, not the
# full multi-MB source archive.
images dataset/
